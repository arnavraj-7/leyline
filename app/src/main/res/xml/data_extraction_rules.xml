<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone: a restored copy of the node id on a second phone
     would make the mesh treat two phones as one and drop their messages. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
